  "nodes": [
    {
      "id": "define-requirements",
      "type": "task",
      "label": "Elicit and document project requirements. Produce a structured folder of\nrequirements: one file per FR, one file per NFR, with Gherkin acceptance\ncriteria embedded in each file, and index files at each folder level.\nAfter stakeholder HIL sign-off, produce a requirements lock file that\ncaptures a stable snapshot for downstream drift detection.\n",
      "hash": "sha256:f629d47aebb26467ca6ac2354521007578e6de26d722875083d5db06f32862b2",
      "metadata": {
        "agent": "ba",
        "phase": "requirements",
        "status": "PENDING"
      }
    },
    {
      "id": "design-l1",
      "type": "task",
      "label": "Produce the L1 system architecture document. Define system components,\ntechnology stack, integration points, and key architectural decisions.\nConsult the requirements lock file (specs/<requirements-task-id>.lock.yaml)\nto ensure the architecture covers all locked FRs and NFRs.\n",
      "hash": "sha256:a089f4eac72293f1562ea6d09994887d74c1b5489a802598b12710ddb3535eaf",
      "metadata": {
        "agent": "architect",
        "phase": "design",
        "status": "PENDING"
      }
    },
    {
      "id": "design-l2",
      "type": "task",
      "label": "Produce L2 component design documents. Define component interfaces,\ndata models, error handling strategy, and observability approach.\nConsult the requirements lock file (specs/<requirements-task-id>.lock.yaml)\nand the L1 architecture document to ensure component designs stay within scope.\n",
      "hash": "sha256:bf5d4420c185b048f81719a4d7f389103ddd708ffa9c80c473bf7aa31d6432fa",
      "metadata": {
        "agent": "pe",
        "phase": "design",
        "status": "PENDING"
      }
    },
    {
      "id": "review-l2",
      "type": "task",
      "label": "Review the L2 component design. Verify component interfaces are correct,\ndata models are complete, and the design aligns with L1 architecture.\nIssue GO/NO_GO decision.\n",
      "hash": "sha256:7621f054b471e34bda2d07f8d5b7229aeb5b291fe4937339f9e01c2510702565",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "security-design-review",
      "type": "task",
      "label": "Security-focused design review. Check: STRIDE threat model completeness,\nall data flows encrypted in transit, PII identified with handling specified,\ninput validation specified for all external inputs, audit logging covers\nsecurity-relevant events, secrets management sound, least-privilege auth,\ncompliance requirements traceable to design decisions.\nIssue SECURITY-GO or SECURITY-NO_GO.\n",
      "hash": "sha256:71e5120c67134d2fa5085059a8c0d679294cf5aa64f9bfbcbac47c6daa47446b",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "plan-tasks",
      "type": "task",
      "label": "Break down the component designs into concrete implementation tasks.\nDefine acceptance criteria (including Gherkin tests) per task, identify\ndependencies, and estimate effort. Output is a folder of one file per task\nplus an index.\n",
      "hash": "sha256:a8c50f6435f7bffef83aa4ab4794eee69e9055c3bc1ddb403622e67b0a739eff",
      "metadata": {
        "agent": "le",
        "phase": "planning",
        "status": "PENDING"
      }
    },
    {
      "id": "implement",
      "type": "task",
      "label": "Implement the feature per the task specification. Write unit tests,\nensure all acceptance criteria pass, fix lint and type errors.\n",
      "hash": "sha256:9e845529f804e7936633b031c16b824dfa9f18d607b1af899f998c45039650be",
      "metadata": {
        "agent": "dev",
        "phase": "implement",
        "status": "PENDING"
      }
    },
    {
      "id": "review-implementation",
      "type": "task",
      "label": "Review the implementation. Check code quality, test coverage, security,\nand conformance to the design. Issue GO/NO_GO decision.\n",
      "hash": "sha256:e604de503319b459e3ff2ce2f685a18d651f0752641e02149509e9892aac4c3b",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "security-test",
      "type": "task",
      "label": "Security testing pass on the implementation. Test:\n- SQL injection: parameterised queries used everywhere, no string concat\n- Input validation: malformed/oversized/special-char inputs return 400\n- Auth bypass: unauthenticated requests return 401/403\n- PII in logs: confirm PII is masked in all log entries\n- Secrets in output: scan all output files for secret patterns\n- Audit log completeness: each auditable event produces a log entry\n- Error leakage: errors don't expose stack traces or internals\nIssue SECURITY-GO or SECURITY-NO_GO per category.\n",
      "hash": "sha256:1c0a246628c159582d0b1b1f078f875d697f931fc1b00b1ad947b2fb01d20514",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "final-sign-off",
      "type": "task",
      "label": "Produce change summary document for human sign-off. Include:\n- Change summary: what was built and what changed\n- Requirements traceability: FR/NFR → implementation → test evidence\n- Security posture: summary of security design review + security test results\n- Open items: known issues, deferred items, post-deploy monitoring\n- Rollback plan: how to revert if the change causes production issues\n- Compliance checklist: confirm each applicable compliance item is satisfied\n",
      "hash": "sha256:c02257caf7133e47e9fc718241db04570abdd910a05ca619d6e4ad888a029487",
      "metadata": {
        "agent": "reviewer",
        "phase": "sign-off",
        "status": "PENDING"
      }
    },
