    {
      "id": "FR-MSR-001",
      "type": "requirement",
      "label": "Slot-based entry model — quantity + time-of-day slot + before/after meal",
      "hash": "sha256:5ee78081d10441d0ff29a49b2e7f943da28d3c15ead6c394fe049a80377087ad",
      "metadata": {}
    },
    {
      "id": "FR-MSR-002",
      "type": "requirement",
      "label": "Deterministic slot-to-clock mapping — 08:00 / 13:00 / 19:00 defaults, family-configurable",
      "hash": "sha256:93bc0f488707256835a9f8c394886ef559617d1f030a89b8b5da058ce9ee8e49",
      "metadata": {}
    },
    {
      "id": "FR-MSR-003",
      "type": "requirement",
      "label": "Structured quantity — amount + unit composed into the rendered dose line",
      "hash": "sha256:a9129afb30ac0b5ce8fe0a5c47572c4a4920dc0ca2a6c4b657d900779abdbcf8",
      "metadata": {}
    },
    {
      "id": "FR-MSR-004",
      "type": "requirement",
      "label": "Purpose at entry — a brief purpose description on every medication",
      "hash": "sha256:d1869db1a3fcff2786b6b823b7ab642a7a2b9ed1b424e71576ff2948aa543e91",
      "metadata": {}
    },
    {
      "id": "FR-MSR-005",
      "type": "requirement",
      "label": "Scan-to-fill — additive beside manual entry, bounded extraction",
      "hash": "sha256:4027626743b6e838cda0a8e7c2c6a6482ce2d437d726bec1e05fed7dd1f735dd",
      "metadata": {}
    },
    {
      "id": "FR-MSR-006",
      "type": "requirement",
      "label": "OCR values require human confirmation before binding — never silent auto-apply",
      "hash": "sha256:8656d761b74954340478031b20d30ddf32bfc89110d6ff0b0cbbf22151b5542e",
      "metadata": {}
    },
    {
      "id": "FR-MSR-007",
      "type": "requirement",
      "label": "Voice acknowledgement names the medication and slot — resolution by what was said",
      "hash": "sha256:075a54f8366b1d5ee34ec45fa9a1e880fa362957d4593886bb2b885b2fa98dcd",
      "metadata": {}
    },
    {
      "id": "FR-MSR-008",
      "type": "requirement",
      "label": "Conservative disambiguation — \"did you mean X / X or Y\" copy rule, never the wrong medication",
      "hash": "sha256:6bdd150d4b7b8acbd9dddeae051eccd5566c13d089dde6e7b345da175a3090fb",
      "metadata": {}
    },
    {
      "id": "FR-MSR-009",
      "type": "requirement",
      "label": "Acknowledgement safety sequence preserved — challenge, then double-dose check, then record",
      "hash": "sha256:7a73c5ceb76174772f3c3e890732aa7300d83d107fcc33bacb87c100cedd3f40",
      "metadata": {}
    },
    {
      "id": "FR-MSR-010",
      "type": "requirement",
      "label": "Intake recorded against the day's schedule — scheduled time and acknowledged time",
      "hash": "sha256:373ca42910b2831b145404347c2afdad5e42503a181deaf9ae68b5aef0b741a5",
      "metadata": {}
    },
    {
      "id": "FR-MSR-011",
      "type": "requirement",
      "label": "Refusal-first denial guard preserved — a denial never falls through to an acknowledgement",
      "hash": "sha256:0e3110778ad338084ea9e63055ad3fd7bb7087de60dffd1b8a4c87ae0fbcda9a",
      "metadata": {}
    },
    {
      "id": "FR-MSR-012",
      "type": "requirement",
      "label": "Mic continuity around acknowledgements — no gap between acknowledgement and listening",
      "hash": "sha256:67bb8e62d87daac622174b5541c8590577c97a68f38e594f924d0c35c7f1d5d5",
      "metadata": {}
    },
    {
      "id": "FR-MSR-013",
      "type": "requirement",
      "label": "Photo of the medication as intake evidence — augments, never replaces, never creates a record",
      "hash": "sha256:090ef934a395b4ab259646a5aeeeade88f26d6bf4bfddf6de4fc622830057370",
      "metadata": {}
    },
    {
      "id": "FR-MSR-014",
      "type": "requirement",
      "label": "Photo evidence resolves the shared slot deterministically — never the wrong medication",
      "hash": "sha256:a47327db3fdf4140a76e9912309f960db9d6bc530ec137ae84ac718ffa64d6b6",
      "metadata": {}
    },
    {
      "id": "FR-MSR-015",
      "type": "requirement",
      "label": "Significant-event notification set — missed dose, double-dose, intake recorded, escalation started",
      "hash": "sha256:c665688e5bd5525982217a41d30e8b05aba13d4fbe1fb726c130c19481cba462",
      "metadata": {}
    },
    {
      "id": "FR-MSR-016",
      "type": "requirement",
      "label": "Caregiver notification channels and honest per-contact delivery",
      "hash": "sha256:4312a391ccac41eada19edac8ac6fb7be6890208ac4a826156938548b399f59c",
      "metadata": {}
    },
    {
      "id": "FR-MSR-017",
      "type": "requirement",
      "label": "PII-free wire — significant events extend the existing taxonomy with no new PII",
      "hash": "sha256:7e66f5e841fea03ca19cf31a0ce4a2da69f76d82f5ffd490dd4201c235dbb2ff",
      "metadata": {}
    },
    {
      "id": "FR-MSR-018",
      "type": "requirement",
      "label": "Honest degradation — deferred capabilities surfaced as themselves, never a false success",
      "hash": "sha256:4c00fb53378ac16546cea00547c26d1bbaaa1ba821906b100031a58081129536",
      "metadata": {}
    },
    {
      "id": "FR-MSR-019",
      "type": "requirement",
      "label": "Existing reminder and escalation semantics preserved — no weakening of medication safety invariants",
      "hash": "sha256:732d4be1d0c19f6a4894d7383f895e6a615820a511a375246722772b27a2df0d",
      "metadata": {}
    },
    {
      "id": "FR-MSR-020",
      "type": "requirement",
      "label": "Dementia machinery preserved and integrated — never rebuilt, never removed",
      "hash": "sha256:5d3ee7ee20b520ba8604a1982378c5dbb1b0831f773e12ad7742f253e2de94e3",
      "metadata": {}
    },
    {
      "id": "FR-MSR-021",
      "type": "requirement",
      "label": "Elderly-fit UX of the new flows — voice-first completion, plain language, vocabulary limit",
      "hash": "sha256:8765d794d09b065c52c58de35387b25dbba1cd04d88c1347ed723fb31b536df8",
      "metadata": {}
    },
    {
      "id": "FR-MSR-022",
      "type": "requirement",
      "label": "Persistence before alarm and process-kill re-arm — the FR-029 invariant holds on the revamped paths",
      "hash": "sha256:68e2cbf3b441e2ffb802c7accd44771d393f5e968f58657f08cc864b1cac58d8",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-001",
      "type": "requirement",
      "label": "LLM independence — the medication scheduler unit stays free of LLM dependencies",
      "hash": "sha256:604fc7e078ea026a947b91f8b6787e053e58de30df9713df557d947bfc8af9ff",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-002",
      "type": "requirement",
      "label": "PII-free observability — hash-only medication identifiers, sanitised logs, gate-covered paths",
      "hash": "sha256:f798f9288c56c8a67f1496f37d89142890ee04fb66bfb21a768170c435cb0829",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-003",
      "type": "requirement",
      "label": "On-device label and photo processing — no new cloud egress for medication content",
      "hash": "sha256:7ebb22b087a9ba810a02dec4b49977ed7191e94f936bd92ba82d58bac4d80228",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-004",
      "type": "requirement",
      "label": "Localisation and spoken times — every new string in Nepali and English, all spoken times through the formatter",
      "hash": "sha256:a623ff81cd0f75e46360a3dde4a830daec91953d5ff1deb380c04468b87de36c",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-005",
      "type": "requirement",
      "label": "Accessibility — 44pt targets, 18pt body text, contrast, voice-first acknowledgement",
      "hash": "sha256:ff99a80206b580b30118fe13af9f8d079f357a311234cb6a100fa4c6c6cac144",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-006",
      "type": "requirement",
      "label": "Migration compatibility — legacy payloads keep loading, schedules are never lost to a missing key",
      "hash": "sha256:c4a013a549e11ed0d2c4a48627fe5806d714b4f9525af28665a1d39076fd7f57",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-007",
      "type": "requirement",
      "label": "Devanagari grapheme-cluster behaviour regression-pinned — do not \"fix\" it",
      "hash": "sha256:af3d827d002567855f4716da54e571e2f53aee9713ad4e6a1dbe33c4c6c32eea",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-008",
      "type": "requirement",
      "label": "Safety-path test rigor — 100 per cent unit coverage, required integration tests, elevated confidence",
      "hash": "sha256:652afd319edcb175bcdf4ae2581b3faedeca317bf9b02a29dc5c04a8f69151c2",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-009",
      "type": "requirement",
      "label": "Compliance and release gates — log-safety gate green, health-policy posture unchanged, honest baseline",
      "hash": "sha256:0b1fb7aaf42d71db80c6fae716dab78336db34c0bc2eb1e53cbd6037d0773f23",
      "metadata": {}
    },
    {
      "id": "NFR-MSR-010",
      "type": "requirement",
      "label": "Reminder firing latency — the mapped clock time is the schedule of record",
      "hash": "sha256:f59adc0dbcfe6aa1baa5dcdd7caff18f04273d9dbda1a7f493415c70d7075fba",
      "metadata": {}
    }
