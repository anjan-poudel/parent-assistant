    {
      "id": "define-requirements",
      "type": "task",
      "label": "Elicit and document project requirements. Produce a structured folder of\nrequirements: one file per FR, one file per NFR, with Gherkin acceptance\ncriteria embedded in each file, and index files at each folder level.\nAfter stakeholder HIL sign-off, produce a requirements lock file that\ncaptures a stable snapshot for downstream drift detection.\n",
      "hash": "sha256:f629d47aebb26467ca6ac2354521007578e6de26d722875083d5db06f32862b2",
      "metadata": {
        "agent": "ba",
        "phase": "requirements",
        "status": "PENDING"
      }
    },
    {
      "id": "design-l1",
      "type": "task",
      "label": "Produce the L1 system architecture document. Define system components,\ntechnology stack, integration points, and key architectural decisions.\nConsult the requirements lock file (specs/<requirements-task-id>.lock.yaml)\nto ensure the architecture covers all locked FRs and NFRs.\n",
      "hash": "sha256:a089f4eac72293f1562ea6d09994887d74c1b5489a802598b12710ddb3535eaf",
      "metadata": {
        "agent": "architect",
        "phase": "design",
        "status": "PENDING"
      }
    },
    {
      "id": "review-l1",
      "type": "task",
      "label": "Review the L1 architecture document. Verify it addresses all requirements,\ncheck for architectural risks, and provide GO/NO_GO decision.\n",
      "hash": "sha256:988a88b96a370e1cfbf96c6f62e00a638036429d558ad22d57fa1a865eac84ab",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "design-l2",
      "type": "task",
      "label": "Produce L2 component design documents. Define component interfaces,\ndata models, error handling strategy, and observability approach.\nConsult the requirements lock file (specs/<requirements-task-id>.lock.yaml)\nand the L1 architecture document to ensure component designs stay within scope.\n",
      "hash": "sha256:bf5d4420c185b048f81719a4d7f389103ddd708ffa9c80c473bf7aa31d6432fa",
      "metadata": {
        "agent": "pe",
        "phase": "design",
        "status": "PENDING"
      }
    },
    {
      "id": "review-l2",
      "type": "task",
      "label": "Review the L2 component design. Verify component interfaces are correct,\ndata models are complete, and the design aligns with L1 architecture.\nIssue GO/NO_GO decision.\n",
      "hash": "sha256:7621f054b471e34bda2d07f8d5b7229aeb5b291fe4937339f9e01c2510702565",
      "metadata": {
        "agent": "reviewer",
        "phase": "review",
        "status": "PENDING"
      }
    },
    {
      "id": "plan-tasks",
      "type": "task",
      "label": "Break down the component designs into concrete implementation tasks.\nDefine acceptance criteria (including Gherkin tests) per task, identify\ndependencies, and estimate effort. Output is a folder of one file per task\nplus an index.\n",
      "hash": "sha256:a8c50f6435f7bffef83aa4ab4794eee69e9055c3bc1ddb403622e67b0a739eff",
      "metadata": {
        "agent": "le",
        "phase": "planning",
        "status": "PENDING"
      }
    },
    {
      "id": "implement",
      "type": "task",
      "label": "Implement the feature per the task specification. Write unit tests,\nensure all acceptance criteria pass, fix lint and type errors.\n",
      "hash": "sha256:9e845529f804e7936633b031c16b824dfa9f18d607b1af899f998c45039650be",
      "metadata": {
        "agent": "dev",
        "phase": "implement",
        "status": "PENDING"
      }
    },
    {
      "id": "review-implementation",
