        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सूचना बन्द छ, त्यसैले टाइमर सकिएको म भन्न सक्दिनँ। तपाईं Settings मा गएर खोल्न सक्नुहुन्छ।"
          }
        }
      }
    },
