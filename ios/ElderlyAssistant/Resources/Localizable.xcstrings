        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाफको सिलसिला: डिभाइसकै दिमागले पहिले जवाफ दिन्छ; ढुक्क नभए क्लाउड दिमागले लिन्छ।"
          }
        }
      }
    },
