    "router.ackDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, I'll remind you again later."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ठीक छ, म पछि फेरि सम्झाउँछु।"
          }
        }
      }
    },
    "router.brainDownloading": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I'm not ready to answer yet. My brain model is still downloading — this only happens once. Please ask me again in a few minutes."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "म अहिले जवाफ दिन तयार छैन। मेरो दिमागको मोडेल अझै डाउनलोड भइरहेको छ — यो एक पटक मात्र हुन्छ। कृपया केही मिनेटपछि फेरि सोध्नुहोस्।"
          }
        }
      }
    },
    "router.brainNeedsSetup": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't answer that yet — my brain isn't set up. Please ask a family member to open Settings and download the brain model or add the Gemini key."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "म त्यसको जवाफ अहिले दिन सक्दिनँ — मेरो दिमाग सेटअप भएको छैन। कृपया परिवारको कसैलाई भन्नुहोस्, सेटिङ खोलेर दिमागको मोडेल डाउनलोड गर्नुहोस् वा जेमिनी कुञ्जी राख्नुहोस्।"
          }
        }
      }
    },
    "router.calendarEventCalendarUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't open the calendar right now. Please turn on calendar access in Settings."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "म अहिले पात्रो खोल्न सक्दिनँ। कृपया सेटिङमा पात्रोको अनुमति खोल्नुहोस्।"
          }
        }
      }
    },
    "router.calendarEventCancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, I won't add it to your calendar."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "हुन्छ, पात्रोमा राख्दिनँ।"
          }
        }
      }
    },
    "router.calendarEventConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Should I add \"%1$@\", at %2$@, to your calendar?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» पात्रोमा %2$@ राखूँ?"
          }
        }
      }
    },
    "router.calendarEventCreated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "\"%1$@\", at %2$@, is in your calendar."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "«%1$@» पात्रोमा %2$@ राखियो।"
          }
        }
      }
    },
    "router.calendarEventNoTime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When should I put it in the calendar? Say the day and time, like \"tomorrow at 8 in the morning\"."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्रोमा कहिले राखूँ? दिन र समय भन्नुहोस्, जस्तै «भोलि बिहान ८ बजे»।"
          }
        }
      }
    },
    "router.calendarEventNoTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What should I write in the calendar? Tell me the name of the event."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पात्रोमा के लेखूँ? कार्यक्रमको नाम भन्नुहोस्।"
          }
        }
      }
    },
    "router.call.appUnsupportedNotice": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't call directly through %@, so I'll use FaceTime instead."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बाट सिधै कल गर्न सकिँदैन, त्यसैले फेसटाइम प्रयोग गर्दैछु।"
          }
        }
      }
    },
    "router.call.calling": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, calling %@."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ठिक छ, %@ लाई कल गर्दैछु।"
          }
        }
      }
    },
    "router.call.cancelled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Okay, cancelled calling %@."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "ठिक छ, %@ लाई कल गर्ने रद्द गरियो।"
          }
        }
      }
    },
    "router.call.confirmQuestion": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Make %2$@ to %1$@?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ लाई %@ गर्ने हो?"
          }
        }
      }
    },
    "router.call.contactNotFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't find %@ in your family contacts. Add them in Settings first."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मैले %@ लाई तपाईंको पारिवारिक सम्पर्कमा भेटिनँ। पहिले सेटिङमा थप्नुहोस्।"
          }
        }
      }
    },
    "router.call.disambiguate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I found more than one matching person (%@). Please say the full name."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ भनेर धेरै जना भेटिए। कृपया पूरा नाम भन्नुहोस्।"
          }
        }
      }
    },
    "router.call.facetimeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "FaceTime isn't available on this device, so I couldn't start the call."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो उपकरणमा फेसटाइम उपलब्ध छैन, त्यसैले कल सुरु गर्न सकिनँ।"
          }
        }
      }
    },
    "router.call.messengerNoHandle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I don't have %@'s Messenger name yet. Please ask family to add it in Settings, or say another way to call."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को म्यासेन्जर नाम थाहा छैन। कृपया परिवारलाई सेटिङमा थप्न लगाउनुहोस्, वा कल गर्ने अर्को तरिका भन्नुहोस्।"
          }
        }
      }
    },
    "router.call.messengerOpened": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I've opened Messenger for %@ — please tap the call button yourself."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को लागि म्यासेन्जर खोलियो — कृपया आफैं कल बटन थिच्नुहोस्।"
          }
        }
      }
    },
    "router.call.messengerWebFallback": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Messenger isn't installed on this phone, so I've opened %@'s chat in the browser instead — please tap the call button yourself."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनमा म्यासेन्जर छैन, त्यसैले %@ को कुराकानी ब्राउजरमा खोलिदिएको छु — कृपया आफैं कल बटन थिच्नुहोस्।"
          }
        }
      }
    },
    "router.call.methodMessengerAudio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "a Messenger audio call"
          }
        },
