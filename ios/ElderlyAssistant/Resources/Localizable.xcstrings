    "pointask.settings.cloud.note":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When this is off, the phone only tells you what it can see by itself — nothing is sent anywhere."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो बन्द हुँदा फोनले आफैं देखेको कुरा मात्र बताउँछ — कहीँ पनि केही पठाइँदैन।"
          }
        }
      }
    },
