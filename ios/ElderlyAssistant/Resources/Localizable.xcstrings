    "calendarShare.status.waiting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing has been shared yet. A reminder is shared as soon as it is created."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेसम्म केही पनि साझा भएको छैन। सम्झना बन्नेबित्तिकै साझा हुन्छ।"
          }
        }
      }
    },
    "calendarShare.consent.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before sharing starts"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "साझा सुरु गर्नुअघि"
          }
        }
      }
    },
    "calendarShare.consent.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Event titles, including medicine names, will be sent to your Google Calendar and shared with invited family contacts. They will see what is coming up on your calendar."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्यक्रमका पूरा नाम — औषधिका नामसमेत — तपाईंको गुगल क्यालेन्डरमा पठाइन्छन् र निम्ता दिइएका परिवारका सदस्यहरूले देख्न सक्छन्। उनीहरूले तपाईंको क्यालेन्डरमा के आउँदैछ देख्नेछन्।"
          }
        }
      }
    },
    "calendarShare.consent.whoCanSee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency contacts are always invited. Other family members are invited for the kinds of reminders you switch on in Notify caregivers."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आपतकालीन सम्पर्कहरूलाई सधैं निम्ता जान्छ। अरू परिवारलाई परिवारलाई खबर गर्नेमा खोल्नुभएका सम्झनाका प्रकारअनुसार निम्ता जान्छ।"
          }
        }
      }
    },
    "calendarShare.consent.revoke": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can stop sharing at any time, and this screen will always tell you what is happening."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईं जहिले पनि साझा गर्न रोक्न सक्नुहुन्छ, र यही स्क्रिनले सधैं के भइरहेको छ भनेर देखाउँछ।"
          }
        }
      }
    },
    "calendarShare.consent.accept": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I understand"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मैले बुझें"
          }
        }
      }
    },
    "calendarShare.error.notSignedIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google is not connected, so nothing is being shared."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगल जोडिएको छैन, त्यसैले केही पनि साझा भइरहेको छैन।"
          }
        }
      }
    },
    "calendarShare.error.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sharing is not set up for this app, so nothing can be shared."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो एपमा क्यालेन्डर साझा मिलाइएको छैन, त्यसैले केही पनि साझा गर्न सकिँदैन।"
          }
        }
      }
    },
    "calendarShare.error.unauthorized": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google has stopped allowing access. Connect the account again to keep sharing."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगलले पहुँच दिन छोडेको छ। साझा जारी राख्न खाता फेरि जोड्नुहोस्।"
          }
        }
      }
    },
    "calendarShare.error.insufficientScopes": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access was refused even though consent was given. Sign out, then connect the account again — if this keeps happening, check the console."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहमति दिइए पनि क्यालेन्डर पहुँच अस्वीकार गरियो। साइन आउट गरेर खाता फेरि जोड्नुहोस् — यस्तै भइरह्यो भने कन्सोल जाँच्नुहोस्।"
          }
        }
      }
    },
    "calendarShare.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google is busy right now. Sharing will try again by itself."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगल अहिले व्यस्त छ। साझा गर्ने काम आफैं फेरि प्रयास गर्नेछ।"
          }
        }
      }
    },
    "calendarShare.error.server": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google had a problem. Sharing will try again by itself."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगलमा समस्या आयो। साझा गर्ने काम आफैं फेरि प्रयास गर्नेछ।"
          }
        }
      }
    },
    "calendarShare.error.malformedResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google sent back something unexpected, so that share did not go through."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगलबाट अनपेक्षित जवाफ आयो, त्यसैले त्यो साझा हुन सकेन।"
          }
        }
      }
    },
    "calendarShare.error.notFound": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A calendar item this phone was updating is no longer on Google. It will be put back the next time it changes."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनले अद्यावधिक गरिरहेको एउटा क्यालेन्डर घटना गुगलमा अब छैन। अर्को पटक परिवर्तन हुँदा यो फेरि राखिनेछ।"
          }
        }
      }
    },
    "calendarShare.error.transport": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not reach Google. Sharing will try again when the phone has internet."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगलसम्म पुग्न सकिएन। फोनमा इन्टरनेट हुँदा साझा गर्ने काम फेरि प्रयास गर्नेछ।"
          }
        }
      }
    },
    "calendarShare.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reminders, alarms and medicine times on this phone keep working either way."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोनका सम्झना, अलार्म र औषधिका बेला जसरी पनि चलिरहन्छन्।"
          }
        }
      }
    },
    "calendarShare.signOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign out of Google"
          }
        },
        "ne": {
