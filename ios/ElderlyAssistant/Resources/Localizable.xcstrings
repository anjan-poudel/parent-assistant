{
  "sourceLanguage": "en",
  "strings": {
    "%@": {},
    "%@ / %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ / %2$@"
          }
        }
      }
    },
    "alarmAlarmKit.honestyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms ring as real system alarms — they sound even in silent mode, and you can stop or snooze them from the Lock Screen."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म वास्तविक सिस्टम अलार्मका रूपमा बज्छन् — साइलेन्ट मोडमा पनि बज्नेछन्, र लक स्क्रिनबाटै बन्द वा स्नुज गर्न सकिन्छ।"
          }
        }
      }
    },
    "alarmAlarmKit.permissionDenied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarm permission is off, so the alarm won't ring. You can turn it on in iPhone Settings."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्मको अनुमति बन्द छ, त्यसैले अलार्म बज्ने छैन। तपाईं आइफोनको Settings मा गएर खोल्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "alarmAlarmKit.snoozeButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Snooze"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "स्नुज"
          }
        }
      }
    },
    "alarms.capacity": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many alarms. Delete one first, then try again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "धेरै अलार्म छन्। एउटा मेट्नुहोस्, अनि फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "alarms.delete": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete alarm"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
