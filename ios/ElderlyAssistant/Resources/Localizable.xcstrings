    "settings.gemini.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahayak understands speech and answers questions using Google's Gemini AI. A family member needs to add an API key here once — without it, only basic commands (medicine, emergency) work."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायकले बोली बुझ्न र प्रश्नको जवाफ दिन Google को Gemini AI प्रयोग गर्छ। परिवारको कसैले यहाँ एकपटक API कुञ्जी थप्नुपर्छ — नभए औषधि र आपतकालीन जस्ता आधारभूत आदेशहरू मात्र काम गर्छन्।"
          }
        }
      }
    },
