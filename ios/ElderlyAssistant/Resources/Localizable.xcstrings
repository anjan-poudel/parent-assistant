        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आपतकालीन सूचना: तपाईंको परिवारका सदस्यको स्वास्थ्य सीमा नाघेको छ। आपतकालीन सेवालाई खबर गरिँदैछ।"
          }
        }
      }
    },
