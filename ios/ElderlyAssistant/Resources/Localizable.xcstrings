    "calendarDisplay.offlineNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Dates, tithis and festivals are computed on this phone from the Bikram Sambat calendar — no internet needed. The tithi may differ by a day from a temple panchanga on transition days."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "मिति, तिथि र चाडपर्व यही फोनमा विक्रम संवत् पात्रोबाट गणना गरिन्छ — इन्टरनेट चाहिँदैन। सङ्क्रमणको दिनमा तिथि मन्दिरको पञ्चाङ्गसँग एक दिन फरक पर्न सक्छ।"
          }
        }
      }
    },
