      }
    },
    "alarms.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No alarms or timers yet"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेसम्म कुनै अलार्म वा टाइमर छैन"
          }
        }
      }
    },
    "alarms.honestyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alarms ring through this app's own notifications — iPhone doesn't let apps set the built-in Clock's alarms."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अलार्म यस एपकै सूचनाबाट बज्छ — आईफोनले एपहरूलाई आफ्नै Clock एपको अलार्म सेट गर्न दिँदैन।"
          }
        }
      }
    },
    "alarms.list.title": {
      "extractionState": "manual",
