          }
        }
      }
    },
    "settings.encoder.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Internal builds only. On, the encoder answers locally as soon as its artifact is installed; off, the brain model picked above keeps the local slot. Emergency and medication replies are handled before either."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आन्तरिक बिल्डका लागि मात्र। खुला हुँदा, इन्कोडर फाइल स्थापना भएपछि इन्कोडरले स्थानीय जवाफ दिन्छ; बन्द हुँदा माथि छानिएको दिमाग मोडेलले स्थानीय स्थान राख्छ। आपतकालीन र औषधि सम्बन्धी जवाफ दुवैभन्दा पहिले व्यवस्थापन हुन्छ।"
