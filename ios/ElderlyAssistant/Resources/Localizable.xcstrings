    "calendarShare.stopSharing.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop sharing your calendar with the family? Reminders and alarms on this phone keep working either way."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवारसँग क्यालेन्डर साझा गर्न रोक्ने हो? यो फोनका सम्झना र अलार्महरू जसरी पनि चलिरहन्छन्।"
          }
