    "youtubeSettings.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A family member can add a YouTube Data API key so voice requests like \"play bhajan on youtube\" find and play the top video. Without a key, the request opens YouTube search directly."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवारका सदस्यले YouTube Data API कुञ्जी थप्न सक्नुहुन्छ — त्यसपछि \"युट्युबमा भजन चलाऊ\" भन्दा उत्कृष्ट भिडियो खोजेर चलाउँछ। कुञ्जी नभए पनि युट्युबमा खोज सिधै खुल्छ।"
          }
        }
      }
    },
    "youtubeSettings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What you say is sent to YouTube to find the video; nothing else is sent."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "भिडियो खोज्न तपाईंले भन्नुभएको कुरा युट्युबमा पठाइन्छ; अरू केही पठाइँदैन।"
          }
        }
      }
    },
    "youtubeSettings.quotaNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Play requests use one YouTube Data API search. YouTube's free quota covers about 100 searches a day."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "चलाउने अनुरोधमा एक YouTube Data API खोज खर्च हुन्छ। युट्युबको निःशुल्क कोटाले दिनमा करिब १०० खोज पुग्छ।"
          }
        }
      }
    },
