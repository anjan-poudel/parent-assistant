    "wakeWord.setupNeedsModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The “Hey Sahayak” listening model is not part of this build. A family member needs to add it and build the app again (tools/fetch-kws-model.sh fetches it)."
