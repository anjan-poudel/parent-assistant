    "router.cloud.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud brain isn't connected. A family member can connect it in Settings."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड दिमाग जोडिएको छैन। परिवारको कसैले सेटिङमा जोड्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "router.cloud.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud brain is busy right now — too many requests. Please try again in a little while."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड दिमाग अहिले व्यस्त छ — धेरै अनुरोध भयो। अलि पछि फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "router.cloud.transportFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I couldn't reach the cloud brain, so I'm using the on-device brain. Please say that again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड दिमागसम्म पुग्न सकिएन, त्यसैले अहिले डिभाइसकै दिमाग प्रयोग गर्दैछु। कृपया फेरि भन्नुहोस्।"
          }
        }
      }
    },
    "router.cloud.invalidResponse": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The cloud brain gave an answer I couldn't use. Please say that again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्लाउड दिमागले काम नलाग्ने जवाफ दियो। कृपया फेरि भन्नुहोस्।"
          }
        }
      }
    },
