    "settings.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice, health information, contacts, and conversations stay on this phone. Nothing is sent to the cloud for AI processing. Health data is only read from HealthKit with your permission. Family notifications are sent only when a configured alert fires."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको आवाज, स्वास्थ्य जानकारी, सम्पर्क र कुराकानी यही फोनमा रहन्छन्। AI प्रशोधनका लागि कुनै पनि कुरा क्लाउडमा पठाइँदैन। स्वास्थ्य जानकारी तपाईंको अनुमतिमा मात्र HealthKit बाट पढिन्छ। परिवारलाई सूचना तोकिएको अलर्ट सक्रिय भएमा मात्र पठाइन्छ।"
          }
        }
      }
    },
