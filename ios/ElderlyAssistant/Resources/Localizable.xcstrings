    "pointask.consent.body":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When you tap 'what is this?', the small picture of the thing you tapped — only that picture, and nothing else from your camera — is sent to the assistant's cloud service to work out what it is. Nothing is sent until you agree, and you can stop it any time."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले 'यो के हो?' थिच्दा, तपाईंले छुनुभएको चीजको सानो तस्बिर मात्र — त्यो तस्बिर, र तपाईंको क्यामेराको अरू केही होइन — के हो भनेर पत्ता लगाउन असिस्टेन्टको क्लाउड सेवामा पठाइन्छ। तपाईंले सहमति नदिएसम्म केही पठाइँदैन, र तपाईं जहिले पनि बन्द गर्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "pointask.consent.decline":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No, keep it on this phone"
