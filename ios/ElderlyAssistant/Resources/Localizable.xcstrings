    "home.calendarLine.question": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give today's date in BOTH the Nepali (Bikram Sambat) and Hindu calendars in ONE short line, e.g. format 'असोज २०, २०८३ बि.सं. • भाद्र २८, १९४७ शक' — no extra words, just the line."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आजको मिति नेपाली (बिक्रम संवत्) र हिन्दू पात्रो दुबैमा एउटै छोटो लाइनमा लेख्नुहोस्, जस्तै 'असोज २०, २०८३ बि.सं. • भाद्र २८, १९४७ शक' — अरू केही नलेख्नुहोस्, त्यही लाइन मात्र।"
          }
        }
      }
    },
