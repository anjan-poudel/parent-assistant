    },
    "settings.cloudCascade.toggleLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send unsure local answers to the cloud"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनिश्चित स्थानीय जवाफ क्लाउडमा पठाउने"
          }
        }
      }
    },
    "settings.cloudCascade.toggleNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, an answer the large local brain gives below the confidence shown below goes to the configured cloud provider — after the spoken hold cue; off, the local answer stands. Inert while no cloud provider is configured."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला हुँदा, तल देखाइएको विश्वासभन्दा कम भएको स्थानीय जवाफ क्लाउडमा जान्छ — पहिले 'एक छिन' भनिन्छ; बन्द हुँदा स्थानीय जवाफ नै रहन्छ। क्लाउड मिलाइएको नभए यसले केही गर्दैन।"
          }
        }
      }
    },
    "settings.diagnostics.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnostics"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "निदान"
          }
        }
      }
    },
    "settings.encoder.artifact": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Encoder artifact: %@"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्कोडर फाइल: %@"
          }
        }
      }
    },
    "settings.encoder.canonicalizerLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rewrite dialect and spelling variants onto the forms the encoder knows"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बोली र हिज्जेका भिन्न रूपहरूलाई इन्कोडरले चिन्ने रूपमा बदल्नुहोस्"
          }
        }
      }
    },
    "settings.encoder.canonicalizerNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, attested variants are rewritten onto their canonical forms after the corrector has run; off, the corrected transcript is passed through as it is. Runs second, on the corrector's output, never on the raw transcript. Ignored while the encoder switch above is off."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला हुँदा, प्रमाणित भिन्न रूपहरू सुधारक चलेपछि तिनका मानक रूपमा बदलिन्छन्; बन्द हुँदा सुधारिएको पाठ जस्ताको तस्तै जान्छ। यो दोस्रो चरणमा, सुधारकको नतिजामाथि चल्छ, मूल पाठमाथि होइन। माथिको इन्कोडर स्विच बन्द हुँदा यो मान्य हुँदैन।"
          }
        }
      }
    },
    "settings.encoder.cascadeLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fall back to the picked brain when the encoder is unsure"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्कोडर अनिश्चित हुँदा माथि छानिएको दिमाग प्रयोग गर्नुहोस्"
          }
        }
      }
    },
    "settings.encoder.cascadeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "On, the brain picked above answers the same turn whenever the encoder abstains or is unsure; off, the encoder answers alone. Ignored while the switch above is off."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला हुँदा, इन्कोडरले जवाफ नदिएको वा अनिश्चित भएको बेला माथि छानिएको दिमागले उही पालोमा जवाफ दिन्छ; बन्द हुँदा इन्कोडर एक्लै जवाफ दिन्छ। माथिको स्विच बन्द हुँदा यो मान्य हुँदैन।"
          }
        }
      }
    },
    "settings.encoder.correctorLabel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repair likely speech-recognition errors before the encoder reads the text"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "इन्कोडरले पाठ पढ्नु अघि आवाज पहिचानका सम्भावित त्रुटिहरू सुधार्नुहोस्"
          }
        }
      }
    },
    "settings.encoder.correctorNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fixes common speech-to-text errors before the local brain reads the utterance — whichever brain serves (the encoder or the picker brain)."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "बोली-देखि-पाठ त्रुटिहरू सुधार्छ — जुनसुकै ब्रेनले सुनोस् (इन्कोडर वा पिकर ब्रेन)।"
          }
        }
      }
    },
    "settings.encoder.lastCorrection": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Last correction"
          }
