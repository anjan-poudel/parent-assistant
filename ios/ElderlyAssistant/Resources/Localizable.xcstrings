            "state": "translated",
            "value": "स्थानीय दिमागले आफैं जवाफ दिन यति विश्वास चाहिन्छ।"
          }
        }
      }
    },
    "settings.cloudCascade.title": {
      "extractionState": "manual",
      "localizations": {
