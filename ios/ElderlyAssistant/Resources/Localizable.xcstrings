    "wakeWord.setupNeedsKey": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Picovoice access key is missing — paste it in the box below."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "Picovoice पहुँच कुञ्जी छैन — तलको बाकसमा टाँस्नुहोस्।"
          }
        }
      }
    },
    "wakeWord.setupNeedsModel": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The trained “Hey Sahayak” keyword file is not part of this build. A family member needs to add it and build the app again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तालिम प्राप्त “हे सहायक” वेक वर्ड फाइल यो संस्करणको हिस्सा होइन। परिवारको कसैले थपेर एप फेरि बनाउनुपर्छ।"
          }
        }
      }
    },
    "wakeWord.setupNeedsRuntime": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listening engine (Porcupine) is not part of this build. A family member needs to enable it and build the app again — step-by-step instructions are in the project."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन्ने इन्जिन (Porcupine) यो संस्करणको हिस्सा होइन। परिवारको कसैले यसलाई जोडेर एप फेरि बनाउनुपर्छ — चरणबद्ध निर्देशन परियोजनामा छन्।"
          }
        }
      }
    },
