    "wakeWord.off.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app is not listening for “Hey Sahayak” right now. Turn the switch on above to listen again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "एपले अहिले “हे सहायक” सुनिरहेको छैन। फेरि सुन्नका लागि माथिको स्विच अन गर्नुहोस्।"
          }
        }
      }
    },
