    "appliance.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sorry, I couldn't help with that photo. Please try again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "माफ गर्नुहोस्, त्यो फोटोबाट मदत गर्न सकिनँ। फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "appliance.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The internet isn't available right now. Please try again later."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिले इन्टरनेट उपलब्ध छैन। पछि फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
