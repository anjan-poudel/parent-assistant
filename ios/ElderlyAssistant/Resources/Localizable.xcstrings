    "wakeWord.phrase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “ये कान्छी” (yeah kanchhi) to wake Sahayak."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
