    "family.contact.emailRequired": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An emergency contact needs an email address, so the family's calendar can send them the invitation."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आपतकालीन सम्पर्कको इमेल ठेगाना चाहिन्छ — परिवारको क्यालेन्डरबाट निम्ता पठाउन यो चाहिन्छ।"
          }
        }
      }
    },
    "family.contact.emailInvalid": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This does not look like an email address. Check for a missing @ or dot."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो इमेल ठेगाना जस्तो देखिँदैन। @ वा डट छुटेको छ कि हेर्नुहोस्।"
          }
        }
      }
    },
    "family.contact.emailHintEmergency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Emergency contacts are invited to every shared reminder, so an email address is required here."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आपतकालीन सम्पर्कलाई हरेक साझा सम्झनामा निम्ता जान्छ, त्यसैले यहाँ इमेल ठेगाना अनिवार्य छ।"
          }
        }
      }
    },
    "settings.calendarSharing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sharing"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्यालेन्डर साझा"
          }
        }
      }
    },
    "caregiverNotify.shareHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Family members can also be invited to see these events on their own calendar. These switches choose who is invited — but an emergency contact is always invited. Set up in Calendar sharing."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "परिवारका सदस्यहरूलाई यी कार्यक्रम आफ्नै क्यालेन्डरमा देख्न पनि निम्ता दिन सकिन्छ। कसलाई निम्ता जान्छ यी स्विचले तय गर्छन् — तर आपतकालीन सम्पर्कलाई सधैँ निम्ता जान्छ। यो क्यालेन्डर साझा भन्ने ठाउँमा मिलाइन्छ।"
          }
        }
      }
    },
    "calendarShare.notConfigured": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar sharing needs a Google sign-in that has not been set up for this app yet. Nothing is being shared. Ask the family member who set up this phone to finish the setup."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "क्यालेन्डर साझा गर्न गुगल साइन-इन चाहिन्छ, जुन यो एपका लागि अझै मिलाइएको छैन। अहिले केही पनि साझा भइरहेको छैन। यो फोन मिलाउनुभएको परिवारको सदस्यलाई सेटअप पूरा गर्न भन्नुहोस्।"
          }
        }
      }
    },
    "calendarShare.signedOut": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Google Calendar is not connected yet, so nothing is being shared. Connect the family's Google account to put your reminders on their calendar."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "गुगल क्यालेन्डर अझै जोडिएको छैन, त्यसैले केही पनि साझा भइरहेको छैन। तपाईंका सम्झनाहरू परिवारको क्यालेन्डरमा राख्न गुगल खाता जोड्नुहोस्।"
          }
        }
      }
    },
