      }
    },
    "calendarShare.scopesMissing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Google account is connected, but Sahayak has not been given permission to use your Google Calendar yet. Nothing is being shared."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको गुगल खाता जोडिएको छ, तर सहायकलाई तपाईंको गुगल क्यालेन्डर प्रयोग गर्ने अनुमति अझै दिइएको छैन। केही पनि साझा भइरहेको छैन।"
          }
        }
      }
    },
    "calendarShare.scopesMissing.howTo": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap below, then allow Calendar and Contacts when Google asks. You can stop sharing at any time."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तल थिच्नुहोस्, अनि गुगलले सोध्दा क्यालेन्डर र सम्पर्कहरूको अनुमति दिनुहोस्। तपाईं जुनसुकै बेला साझा गर्न रोक्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "calendarShare.scopesMissing.reconnect": {
