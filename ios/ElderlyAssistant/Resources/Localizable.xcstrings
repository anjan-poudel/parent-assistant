    "pointask.consent.grantedNote":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The small picture of the thing you tap is sent to the assistant's cloud service. You can stop this at any time."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंले छुनुभएको चीजको सानो तस्बिर असिस्टेन्टको क्लाउड सेवामा पठाइन्छ। तपाईं जहिले पनि यो बन्द गर्न सक्नुहुन्छ।"
          }
        }
      }
    },
    "pointask.consent.grantedTitle":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Looking at pictures online is on"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अनलाइन तस्बिर हेर्ने चालु छ"
          }
        }
      }
    },
    "pointask.consent.revoke":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop using the internet to look at pictures"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तस्बिर हेर्न इन्टरनेट प्रयोग बन्द गर्नुहोस्"
          }
        }
      }
    },
    "pointask.consent.revokeFailedNote":     {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is being sent now, but the setting may come back when the app is restarted. Please try again."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिले केही पठाइँदैन, तर एप फेरि खोल्दा यो सेटिङ फर्किन सक्छ। कृपया फेरि प्रयास गर्नुहोस्।"
          }
        }
      }
    },
    "pointask.consent.revokeFailedTitle":     {
      "extractionState": "manual",
