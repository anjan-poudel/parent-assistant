          "stringUnit": {
            "state": "translated",
            "value": "आवाज नमुना %d / %d"
          }
        }
      }
    },
    "voiceSettings.biometric.enroll.record": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Start recording"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रेकर्ड सुरु गर्नुहोस्"
          }
        }
      }
    },
    "voiceSettings.biometric.enroll.recordingHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recording… press Stop when you finish speaking."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रेकर्ड हुँदैछ… बोलिसकेपछि रोक्नुहोस् थिच्नुहोस्।"
          }
        }
      }
    },
    "voiceSettings.biometric.enroll.stop": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "रोक्नुहोस्"
          }
        }
      }
    },
    "voiceSettings.biometric.enrollButton": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enroll voice"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज दर्ता गर्नुहोस्"
          }
        }
      }
    },
    "voiceSettings.biometric.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice recordings are used only to build or check the voice model, and they never leave this device. The voice model is kept in this device's secure storage."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंका आवाजका रेकर्डिङ आवाजको नमुना बनाउन वा जाँच्न मात्र प्रयोग हुन्छन्, र यन्त्रबाट कहिल्यै बाहिर जाँदैनन्। आवाजको नमुना यसै यन्त्रको सुरक्षित भण्डारमा रहन्छ।"
          }
        }
      }
    },
    "voiceSettings.biometric.remove": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove voice"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज हटाउनुहोस्"
          }
        }
      }
    },
    "voiceSettings.biometric.removeConfirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove the saved voice? You can record it again any time."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित आवाज हटाउने हो? जतिबेला पनि फेरि रेकर्ड गर्न सकिन्छ।"
          }
        }
      }
    },
    "voiceSettings.biometric.status.disabled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not available in this version"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो संस्करणमा उपलब्ध छैन"
          }
        }
      }
    },
    "voiceSettings.biometric.status.disabled.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice fingerprinting is switched off in this build of the app."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो एपको यस संस्करणमा आवाजको औंठाछाप बन्द गरिएको छ।"
          }
        }
      }
    },
    "voiceSettings.biometric.status.enrolled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice saved"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज सुरक्षित छ"
          }
        }
      }
    },
    "voiceSettings.biometric.status.enrolled.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%d voice samples saved on this device."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "%d वटा आवाजका नमुना यही यन्त्रमा सुरक्षित छन्।"
          }
        }
      }
    },
    "voiceSettings.biometric.status.needsReenrollment": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Needs re-recording"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "फेरि रेकर्ड गर्नुपर्ने"
          }
        }
      }
    },
    "voiceSettings.biometric.status.needsReenrollment.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved voice was made by a different voice system, so it cannot be used anymore. Record your voice again to keep it working."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित आवाज अर्कै आवाज प्रणालीबाट बनेकोले अब प्रयोग गर्न मिल्दैन। चालु राख्न आफ्नो आवाज फेरि रेकर्ड गर्नुहोस्।"
          }
        }
      }
    },
    "voiceSettings.biometric.status.notEnrolled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No voice saved yet"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "अहिलेसम्म आवाज सुरक्षित छैन"
          }
        }
      }
    },
    "voiceSettings.biometric.status.notEnrolled.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your voice fingerprint is not set up yet. You can record it below — it stays on this device."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको आवाजको औंठाछाप अझै बनेको छैन। तल रेकर्ड गर्न सक्नुहुन्छ — यो यही यन्त्रमा रहन्छ।"
          }
        }
      }
    },
    "voiceSettings.biometric.status.unreadable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved voice is unreadable"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित आवाज पढ्न मिलेन"
          }
        }
      }
    },
    "voiceSettings.biometric.status.unreadable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved voice cannot be read on this device. Record it again — it cannot be recovered."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरक्षित आवाज यस यन्त्रमा पढ्न सकिएन। फेरि रेकर्ड गर्नुहोस् — पुरानो फिर्ता हुँदैन।"
          }
        }
      }
    },
    "voiceSettings.biometric.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice fingerprint"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाजको औंठाछाप"
          }
        }
      }
    },
    "voiceSettings.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Control how the assistant hears you — background noise, your accent, and an optional voice fingerprint that stays on this device."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायकले तपाईंलाई कसरी सुन्छ नियन्त्रण गर्नुहोस् — पछाडिको आवाज, तपाईंको उच्चारण, र यही यन्त्रमा रहने वैकल्पिक आवाजको औंठाछाप।"
          }
        }
      }
    },
    "voiceSettings.interpreter.cloud": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open questions are answered by Gemini over the internet."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला प्रश्नको जवाफ इन्टरनेटबाट जेमिनीले दिन्छ।"
          }
        }
      }
    },
    "voiceSettings.interpreter.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open questions are answered on this device."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "खुला प्रश्नको जवाफ यही यन्त्रमा दिइन्छ।"
          }
        }
      }
    },
    "voiceSettings.mic.allow": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow microphone"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोनलाई अनुमति दिनुहोस्"
          }
        }
      }
    },
    "voiceSettings.mic.askBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The assistant records your voice for a few seconds at a time, three times, to learn how you sound. The recordings stay on this device."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायकले तपाईंको आवाज कस्तो छ भनेर सिक्न एक पटकमा केही सेकेन्ड गरी तीन पटक रेकर्ड गर्छ। रेकर्डिङ यही यन्त्रमै रहन्छन्।"
          }
        }
      }
    },
    "voiceSettings.mic.askTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Allow the microphone?"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोनको अनुमति दिने हो?"
          }
        }
      }
    },
    "voiceSettings.mic.deniedBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The voice fingerprint cannot be recorded without it. Turn it on in the system Settings, then come back."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो बिना आवाजको औंठाछाप रेकर्ड गर्न सकिँदैन। प्रणालीको सेटिङ्समा गएर अन गर्नुहोस्, अनि फर्केर आउनुहोस्।"
          }
        }
      }
    },
    "voiceSettings.mic.deniedTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Microphone access is off"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोफोनको पहुँच बन्द छ"
          }
        }
      }
    },
    "voiceSettings.noise.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Softens steady background noise (fans, traffic) in what the assistant hears. Experimental and off by default. All processing happens on this device. It may not help in echoey rooms or with very loud speech."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायकले सुन्ने आवाजमा एकनासको पछाडिको आवाज (पङ्खा, गाडीको आवाज) नरम पार्छ। प्रयोगात्मक सुविधा हो, सुरुमा बन्द हुन्छ। सबै काम यही यन्त्रमै हुन्छ। प्रतिध्वनि भएको कोठा वा धेरै ठूलो आवाजमा फाइदा नहुन सक्छ।"
          }
        }
      }
    },
    "voiceSettings.noise.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduce background noise"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पछाडिको आवाज कम गर्ने"
          }
        }
      }
    },
    "voiceSettings.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The noise filter and accent help work entirely on this device. They do not change where your voice is sent when you talk to the assistant."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज फिल्टर र उच्चारण सहयोग पूरै यही यन्त्रमा चल्छन्। सहायकसँग बोल्दा तपाईंको आवाज कहाँ पठाइन्छ भन्ने यसले परिवर्तन गर्दैन।"
          }
        }
      }
    },
    "voiceSettings.timing.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows how long each step of a voice reply took (listening, thinking, speaking) under the assistant's reply in the conversation. For diagnosing slow replies only — these timings stay on this device and are never sent anywhere."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सहायकको जवाफमुनि आवाजको जवाफका हरेक चरण (सुन्ने, सोच्ने, बोल्ने) लाई कति समय लाग्यो भन्ने देखाउँछ। ढिलो जवाफ जाँच्नका लागि मात्र — यी समयहरू यही यन्त्रमै बस्छन्, कतै पठाइँदैनन्।"
          }
        }
      }
    },
    "voiceSettings.timing.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Show conversation timing"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "कुराकानीको समय देखाऊ"
          }
        }
      }
    },
    "voiceSettings.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Voice personalization"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "आवाज निजीकरण"
          }
        }
      }
    },
    "voiceSettings.warmStart.caption": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Preloads the speech and reply-voice models during startup, so the first conversation starts sooner. Uses some extra memory and battery for a short while after each launch. Applies from the next launch."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुरुवातमा नै बोली र उत्तर दिने आवाजका मोडेल पहिल्यै लोड गर्छ, जसले गर्दा पहिलो कुराकानी छिटो सुरु हुन्छ। प्रत्येक पटक खोल्दा केही बेर थोरै बढी मेमोरी र ब्याट्री खर्च हुन्छ। अर्को पटक खोल्दादेखि लागू हुन्छ।"
          }
        }
      }
    },
    "voiceSettings.warmStart.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Faster first conversation"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "पहिलो कुराकानी छिटो"
          }
        }
      }
    },
    "wakeWord.active.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “Hey Sahayak”, pause briefly, then speak your command — for example: “Hey Sahayak, remind me to take medicine at 8.”"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "“हे सहायक” भन्नुहोस्, छोटो रोकिनुहोस्, अनि आफ्नो आदेश बोल्नुहोस् — उदाहरण: “हे सहायक, मलाई ८ बजे औषधि खान सम्झाउनुहोस्।”"
          }
        }
      }
    },
    "wakeWord.active.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening is on"
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन्ने सुविधा सक्रिय छ"
          }
        }
      }
    },
    "wakeWord.batteryNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "While this is on, the microphone listens all the time, which uses a little more battery. Switch it off here any time."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो अन हुँदा माइक्रोफोनले सधैं सुनिरहन्छ, जसले अलि बढी ब्याट्री खपत गर्छ। जतिबेला पनि यहाँबाट बन्द गर्न सकिन्छ।"
          }
        }
      }
    },
    "wakeWord.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With the wake word on, Sahayak listens for “Hey Sahayak” and then takes your command by itself — no button press."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "वेक वर्ड अन हुँदा, सहायकले “हे सहायक” सुन्छ र त्यसपछि आफैं तपाईंको आदेश लिन्छ — बटन थिच्नु पर्दैन।"
          }
        }
      }
    },
    "wakeWord.modelBundled": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The listening model comes with the app — nothing else to set up."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन्ने मोडेल एपसँगै रहन्छ — अरू केही सेटअप गर्नुपर्दैन।"
          }
        }
      }
    },
    "wakeWord.needsSetup.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Listening is switched on, but something the wake word needs is missing — it is listed below. Once a family member fixes it, listening starts on the next launch."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "सुन्ने स्विच अन गरिएको छ, तर वेक वर्डका लागि चाहिने केही कुरा छैन — के छैन भन्ने तल दिइएको छ। परिवारको कसैले मिलाएपछि, अर्को पटक एप खोल्दा सुन्ने सुविधा सुरु हुन्छ।"
          }
        }
      }
    },
    "wakeWord.needsSetup.title": {
