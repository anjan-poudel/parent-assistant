    "appliance.closerPhotoHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I can't mark the exact spot on this photo. Follow the written steps, or take a closer photo of the buttons."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "यो फोटोमा ठीक ठाउँ देखाउन सकिनँ। लेखिएका चरणहरू पालना गर्नुहोस्, वा बटनहरूको नजिकबाट अर्को फोटो खिच्नुहोस्।"
          }
        }
      }
    },
    "appliance.dismiss": {
      "extractionState": "manual",
