    "settings.voiceEngine.explanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose which assistant engine runs your voice commands. Gemini uses the internet; On-device works fully offline once its models are downloaded."
          }
        },
        "ne": {
          "stringUnit": {
            "state": "translated",
            "value": "तपाईंको आवाज आदेश कुन इन्जिनले चलाउने छनौट गर्नुहोस्। जेमिनीले इन्टरनेट प्रयोग गर्छ; यन्त्रमै भने मोडेलहरू डाउनलोड भइसकेपछि पूर्ण रूपमा इन्टरनेट बिना काम गर्छ।"
          }
        }
      }
    },
